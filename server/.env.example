# M3 — ERP / Accounting (server)
NODE_ENV=production
PORT=5002
MONGODB_URI=mongodb://mongo:27017/orgx

JWT_ACCESS_SECRET=CHANGE_ME_STRONG_RANDOM_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_RANDOM_64_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLIENT_URL=https://erp.yourdomain.com

SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=CHANGE_ME
EMAIL_FROM=noreply@yourdomain.com

# AES-256-GCM encryption key for sensitive fields (openssl rand -hex 32)
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
